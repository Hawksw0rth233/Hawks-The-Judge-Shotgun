    "handbookPriceRoubles": 54000,
    "fleaPriceRoubles": 54000,
    "addtoTraders": false,
    "locales": {
      "en": {
        "name": "\"The Judge\" .410 revolver",
        "shortName": "The Judge",
        "description": "A classic revolving shotgun. Its devastating damage at close range, barely controllable recoil and surprisingly effective gas seal make quite an impression. For some reason, a crew of criminals from Washington, D.C. who wear clown masks are particularly fond of it."
      },
      "ch": {
        "name": "“判官” .410 左轮霰弹枪",
        "shortName": "判官",
        "description": "一把经典的转轮霰弹枪。近距离下极高的伤害，几乎无法控制的后坐力与意外地出色的气密性使它令人印象深刻。不知为何，这把枪十分受到一伙来自华盛顿的面具小丑犯罪组织青睐。"
      },
      "ja": {
        "name": "「ジャッジ」 .410 リボルバーショットガン",
        "shortName": "ジャッジ",
        "description": "古典的なリボルバーショットガン。至近距離での凄まじい威力、制御しきれないほどの反動、そして意外なほど優れた気密性が強烈な印象を残す。なぜか、ワシントンD.C.を拠点に道化師の仮面をかぶって活動する犯罪グループが、この銃をいたく気に入っている。"
      }
    },
